{
  "name": "inbox-analyzer",
  "version": "1.0.0",
  "description": "Gmail Mailbox Analyzer — Visual dashboard for understanding inbox composition",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "NODE_ENV=production node server/index.js",
    "docker-build": "docker build -t inbox-analyzer .",
    "docker-run": "docker run -p 3000:3000 --env-file .env inbox-analyzer"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.2.0",
    "morgan": "^1.10.1",
    "open": "^10.1.0"
  }
}
